{
    "name": "@hodfords/nestjs-storage",
    "version": "12.0.2",
    "description": "Provides integration with third-party cloud storage solutions in NestJS apps",
    "homepage": "https://github.com/hodfords-solutions/nestjs-storage#readme",
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-storage/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-storage.git"
    },
    "license": "UNLICENSED",
    "author": "",
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsc -p tsconfig.build.json",
        "format": "prettier --write \"sample/*/**/*.ts\" \"lib/**/*.ts\"",
        "postbuild": "cp package.json dist/lib && cp README.md dist/lib && cp .npmrc dist/lib",
        "lint": "eslint \"{sample/*,apps,lib,test}/**/*.ts\" --fix",
        "prepare": "is-ci || husky",
        "release:patch": "git add CHANGELOG.md && npm version patch --tag-version-prefix='' -f -m 'chore: release to %s'",
        "release:push": "git push --no-verify && git push --tags --no-verify",
        "start": "nest start -p tsconfig.sample.json",
        "start:debug": "nest start --debug --watch -p tsconfig.sample.json",
        "start:dev": "npm run prebuild && nest start --watch -p tsconfig.sample.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "version": "auto-changelog && git add CHANGELOG.md",
        "wz-command": "wz-command"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.981.0",
        "@aws-sdk/lib-storage": "3.981.0",
        "@aws-sdk/s3-request-presigner": "3.981.0",
        "@azure/storage-blob": "12.30.0",
        "adm-zip": "0.5.16",
        "dayjs": "1.11.19",
        "dotenv": "^17.2.3",
        "eslint-config-prettier": "^10.1.8",
        "express": "5.2.1",
        "proxy-agent": "6.5.0",
        "sharp": "0.34.5",
        "slugify": "1.6.6",
        "uuid": "^13.0.0"
    },
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0"
    },
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "^11.0.2",
        "@hodfords/nestjs-prettier-config": "^11.0.1",
        "@nestjs/cli": "12.0.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/testing": "12.0.1",
        "@swc/core": "^1.13.5",
        "@types/adm-zip": "^0.5.7",
        "@types/express": "5.0.6",
        "@types/multer": "2.0.0",
        "@types/node": "25.2.0",
        "@types/supertest": "6.0.3",
        "@types/uuid": "^10.0.0",
        "auto-changelog": "2.5.0",
        "axios": "^1.13.4",
        "eslint": "9.39.2",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "16.2.7",
        "prettier": "3.8.1",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.2",
        "rxjs": "7.8.2",
        "supertest": "7.2.2",
        "typescript": "5.9.3",
        "unplugin-swc": "^1.5.7",
        "vitest": "^4.1.10"
    }
}
